# Copiar a server/.env y ajustar si hace falta.
# `docker compose -f server/docker-compose.yml up -d` lee este archivo.

# Tag de la imagen de Suwayomi-Server (stable | preview).
SUWAYOMI_TAG=stable

# Puerto en el host para la API/WebUI del servidor.
SUWAYOMI_PORT=4567

# Zona horaria (nombre de la base de datos TZ).
TZ=Etc/UTC

# Credenciales: SOLO se usan si se activa AUTH_MODE=basic_auth en el compose.
SUWAYOMI_USER=admin
SUWAYOMI_PASSWORD=changeme
