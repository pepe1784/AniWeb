# Copia a infra/.env y personaliza. No commitees .env reales.
# --- Web (nginx) ---
WEB_PORT=8080
# Base path: "/" si es un user site o despliegue en raiz; "/AniWeb/" en subruta.
VITE_BASE_PATH=/

# --- Proxy CORS opcional (perfil cors-proxy) ---
PROXY_PORT=8787
# Dominios permitidos por defecto, separados por comas.
# Vacio = el proxy confia en la lista que envia la app (X-AniWeb-Allow).
PROXY_ALLOWED_DOMAINS=
# Limites y opciones (opcionales):
# PROXY_ALLOW_METHODS=GET,HEAD,POST
# PROXY_MAX_BYTES=33554432
# PROXY_TIMEOUT_MS=20000
# PROXY_MAX_REDIRECTS=3
# Token compartido (recomendado en proxies publicos). Si se define, exige X-AniWeb-Token.
# PROXY_TOKEN=
# Permitir hosts privados/loopback (solo para desarrollo). Def. no.
# PROXY_ALLOW_PRIVATE=0

# --- HTTPS con Caddy (override docker-compose.caddy.yml) ---
DOMAIN=aniweb.tudominio.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443