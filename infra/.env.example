# Copia a infra/.env y personaliza. No commitees .env reales.
# --- Web (nginx) ---
WEB_PORT=8080
# Base path: "/" si es un user site o despliegue en raiz; "/AniWeb/" en subruta.
VITE_BASE_PATH=/

# --- Proxy CORS opcional (perfil cors-proxy) ---
PROXY_PORT=8787
# Dominios permitidos por defecto, separados por comas (vacio = solo los que envia la app).
PROXY_ALLOWED_DOMAINS=

# --- HTTPS con Caddy (override docker-compose.caddy.yml) ---
DOMAIN=aniweb.tudominio.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443